# BSD (sports.bzzoiro.com) — the sole data provider. Get a token at
# https://sports.bzzoiro.com
# Free football tier: no rate limit, current-season + expected-goals (xG) data.
BSD_KEY=your_bsd_token_here

# LLM for Match Insight. Omit LLM_API_KEY to fall back to the deterministic
# template (insight.generatedBy becomes "template"; with a key it's "ai").
# Provider: "groq" (default) | "gemini" | "openrouter" — all OpenAI-compatible.
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_key_here
# Optional; defaults to openai/gpt-oss-20b.
LLM_MODEL=
